# Native code/compiler contract; curated qualification DATA is excluded so that
# adding an evidence record never changes the contract it is qualifying.
function(densecore_compute_native_fingerprint root contract out_hash out_environment)
    set(glob_tracking)
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set(glob_tracking CONFIGURE_DEPENDS)
    endif()
    file(GLOB_RECURSE native_files ${glob_tracking} LIST_DIRECTORIES FALSE RELATIVE "${root}"
        "${root}/src/*" "${root}/include/*" "${root}/cmake/*"
        "${root}/third_party/ggml/src/*" "${root}/third_party/ggml/include/*"
        "${root}/third_party/ggml/cmake/*")
    list(APPEND native_files "CMakeLists.txt" "third_party/ggml/CMakeLists.txt")
    list(FILTER native_files EXCLUDE REGEX "(^|/)qualification_registry_data\\.inl$")
    list(FILTER native_files EXCLUDE REGEX "(^|/)(\\.git|build[^/]*)/")
    list(SORT native_files)
    set(manifest "densecore-native-contract-v1\n${contract}\n")
    set(environment "DENSECORE_SPEC_TYPE" "DENSECORE_SPEC_DRAFT_N_MAX"
        "DENSECORE_GO_WORKERS" "DENSECORE_SERVER_INFLIGHT" "DENSECORE_ENGINE_THREADS")
    foreach(relative IN LISTS native_files)
        if(NOT EXISTS "${root}/${relative}")
            continue()
        endif()
        file(SHA256 "${root}/${relative}" digest)
        string(APPEND manifest "${relative}:${digest}\n")
        if(NOT CMAKE_SCRIPT_MODE_FILE)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${root}/${relative}")
        endif()
        if(relative MATCHES "^(src|include)/")
            file(READ "${root}/${relative}" body)
            string(REGEX MATCHALL "\"(DENSECORE|GGML|OMP|KMP)_[A-Z][A-Z0-9_]*\"" keys "${body}")
            foreach(key IN LISTS keys)
                string(REPLACE "\"" "" key "${key}")
                list(APPEND environment "${key}")
            endforeach()
        endif()
    endforeach()
    list(REMOVE_DUPLICATES environment)
    list(SORT environment)
    string(SHA256 fingerprint "${manifest}")
    set(${out_hash} "${fingerprint}" PARENT_SCOPE)
    set(${out_environment} "${environment}" PARENT_SCOPE)
endfunction()

function(densecore_generate_native_fingerprint)
    set(contract "compiler=${CMAKE_CXX_COMPILER_ID}:${CMAKE_CXX_COMPILER_VERSION}:${CMAKE_CXX_COMPILER_TARGET}\n")
    if(EXISTS "${CMAKE_CXX_COMPILER}")
        file(SHA256 "${CMAKE_CXX_COMPILER}" compiler_hash)
        string(APPEND contract "compiler-bytes=${compiler_hash}\n")
    endif()
    string(APPEND contract "system=${CMAKE_SYSTEM_NAME}:${CMAKE_SYSTEM_PROCESSOR}\nstandard=${CMAKE_CXX_STANDARD}\n")
    get_cmake_property(cache_keys CACHE_VARIABLES)
    list(SORT cache_keys)
    foreach(key IN LISTS cache_keys)
        if(key MATCHES "^(DENSECORE_|GGML_|HWY_|CMAKE_(BUILD_TYPE|CXX_FLAGS|C_FLAGS|ASM_FLAGS|INTERPROCEDURAL_OPTIMIZATION|SHARED_LINKER_FLAGS))" AND
           NOT key MATCHES "(GIT_COMMIT|TIMESTAMP|QUALIFICATION_REGISTRY_DATA)")
            string(APPEND contract "${key}=${${key}}\n")
        endif()
    endforeach()
    foreach(target densecore ggml ggml-cpu hwy)
        if(TARGET ${target})
            foreach(property COMPILE_OPTIONS COMPILE_DEFINITIONS INTERFACE_COMPILE_OPTIONS INTERFACE_COMPILE_DEFINITIONS)
                get_target_property(value ${target} ${property})
                string(APPEND contract "${target}:${property}=${value}\n")
            endforeach()
        endif()
    endforeach()
    get_directory_property(directory_options COMPILE_OPTIONS)
    get_directory_property(directory_definitions COMPILE_DEFINITIONS)
    string(APPEND contract "directory_options=${directory_options}\ndirectory_definitions=${directory_definitions}\n")
    # Highway is fetched outside the source tree; hash actual bytes as well as
    # the pinned declaration. A modified fetched dependency must invalidate proof.
    if(DEFINED highway_SOURCE_DIR AND EXISTS "${highway_SOURCE_DIR}/hwy/highway.h")
        file(GLOB_RECURSE highway_files CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE
            RELATIVE "${highway_SOURCE_DIR}" "${highway_SOURCE_DIR}/hwy/*")
        list(SORT highway_files)
        foreach(relative IN LISTS highway_files)
            file(SHA256 "${highway_SOURCE_DIR}/${relative}" digest)
            string(APPEND contract "highway/${relative}:${digest}\n")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${highway_SOURCE_DIR}/${relative}")
        endforeach()
    else()
        # Incomplete dependency provenance deliberately disables AUTO capture.
        set(missing_dependency TRUE)
    endif()
    string(REPLACE "${CMAKE_CURRENT_SOURCE_DIR}" "<core>" contract "${contract}")
    string(REPLACE "${CMAKE_CURRENT_BINARY_DIR}" "<build>" contract "${contract}")
    densecore_compute_native_fingerprint("${CMAKE_CURRENT_SOURCE_DIR}" "${contract}" DENSECORE_NATIVE_BUILD_FINGERPRINT known_environment)
    if(missing_dependency)
        set(DENSECORE_NATIVE_BUILD_FINGERPRINT "")
    endif()
    set(DENSECORE_NATIVE_ENVIRONMENT_INITIALIZER "")
    foreach(key IN LISTS known_environment)
        string(APPEND DENSECORE_NATIVE_ENVIRONMENT_INITIALIZER "    \"${key}\",\n")
    endforeach()
    list(LENGTH known_environment DENSECORE_NATIVE_ENVIRONMENT_COUNT)
    configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/native_fingerprint.h.in"
        "${CMAKE_CURRENT_BINARY_DIR}/include/densecore_native_fingerprint.h" @ONLY)
endfunction()
