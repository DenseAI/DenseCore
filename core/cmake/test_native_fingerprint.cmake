# Standalone deterministic provenance regression: cmake -P this-file.
include("${CMAKE_CURRENT_LIST_DIR}/native_fingerprint.cmake")
set(root "/tmp/densecore-native-fingerprint-test")
string(RANDOM LENGTH 12 suffix)
string(APPEND root "-${suffix}")
file(MAKE_DIRECTORY "${root}/src" "${root}/third_party/ggml")
file(WRITE "${root}/CMakeLists.txt" "project(fixture)\n")
file(WRITE "${root}/src/kernel.cpp" "// first kernel\n")
file(WRITE "${root}/src/qualification_registry_data.inl" "// empty registry\n")
densecore_compute_native_fingerprint("${root}" "compiler-a" first environment)
file(WRITE "${root}/src/qualification_registry_data.inl" "// curated qualification data added\n")
densecore_compute_native_fingerprint("${root}" "compiler-a" registry_changed ignored)
if(NOT first STREQUAL registry_changed)
    message(FATAL_ERROR "Registry DATA changed the native contract")
endif()
file(WRITE "${root}/src/kernel.cpp" "// different kernel\n")
densecore_compute_native_fingerprint("${root}" "compiler-a" source_changed ignored)
densecore_compute_native_fingerprint("${root}" "compiler-b" compiler_changed ignored)
file(MAKE_DIRECTORY "${root}/fetched/simde" "${root}/fetched/.git")
file(WRITE "${root}/fetched/simde/kernel.h" "// original dependency\n")
file(WRITE "${root}/fetched/.git/index" "metadata-a")
densecore_dependency_fingerprint("${root}/fetched" dependency_first)
file(WRITE "${root}/fetched/.git/index" "metadata-b")
densecore_dependency_fingerprint("${root}/fetched" dependency_metadata)
file(WRITE "${root}/fetched/simde/kernel.h" "// modified dependency\n")
densecore_dependency_fingerprint("${root}/fetched" dependency_changed)
densecore_dependency_fingerprint("${root}/missing" dependency_missing)
if(NOT dependency_first STREQUAL dependency_metadata OR dependency_first STREQUAL dependency_changed OR
   dependency_first STREQUAL "" OR NOT dependency_missing STREQUAL "")
    message(FATAL_ERROR "Fetched dependency bytes/metadata/missing provenance invariants failed")
endif()
file(REMOVE_RECURSE "${root}")
if(first STREQUAL source_changed OR source_changed STREQUAL compiler_changed)
    message(FATAL_ERROR "Source/compiler change failed to invalidate native contract")
endif()
message(STATUS "Native fingerprint DATA/source/compiler/dependency invariants passed")
